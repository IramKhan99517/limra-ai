# Copy this file to .env.local for local development.
# In production, set DATABASE_URL in your Vercel project's
# Settings → Environment Variables instead.

# Get this from Neon (neon.tech) or Supabase (supabase.com) — both have free tiers.
# Neon example:     postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
# Supabase example: postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres
DATABASE_URL=

# Get these from Supabase → Project Settings → API
# (Project URL and "anon" "public" key — safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. If set, business intake (/onboarding) uses Claude to classify
# the business and write a plain-language summary. If not set, a
# rule-based keyword classifier is used instead — the app works either way.
ANTHROPIC_API_KEY=
